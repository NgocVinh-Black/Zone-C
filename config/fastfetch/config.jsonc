{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "~/.local/share/zone-c/src/assets/logo.png",
    "width": 14,
    "height": 7,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 13
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#cdd6f4"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#89b4fa"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#89b4fa"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": " cpu",
      "keyColor": "#74c7ec"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#94e2d5"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#cba6f7"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
