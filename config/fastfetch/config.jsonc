{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#e6efff"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#3d9bff"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#3d9bff"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": " cpu",
      "keyColor": "#ffa66e"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#42e8b4"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#86b4ff"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
