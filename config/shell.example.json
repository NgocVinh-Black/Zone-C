{
  "general": {
    "uiScale": 1
  },
  "theme": {
    "matugen": false
  },
  "weather": {
    "unit": "metric",
    "intervalMinutes": 30
  },
  "bar": {
    "left": [["launcher"], ["notifications"], ["workspaces"], ["media"]],
    "center": [["clock", "weather"]],
    "right": [["tray"], ["keyboard", "network", "bluetooth", "volume", "battery"]]
  },
  "enabled": ["clipboard", "osd"],
  "features": {
    "workspaces": { "count": 8 },
    "clock": { "timeFormat": "hh:mm:ss AP", "dateFormat": "dddd, MMMM dd" },
    "launcher": { "terminal": ["kitty", "-e"], "placeholder": "Search applications" },
    "clipboard": { "maxEntries": 200 },
    "notifications": { "maxToasts": 4, "timeoutMs": 6000, "keepCritical": true },
    "osd": { "timeoutMs": 1600 },
    "battery": { "lockCommand": ["loginctl", "lock-session"] }
  }
}
