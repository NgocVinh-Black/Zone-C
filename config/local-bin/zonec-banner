#!/usr/bin/env bash
# Banner Zone-C (phong cach than sam) khi mo terminal.

cols=$(tput cols 2>/dev/null || echo 80)

# Tong xanh dien cua logo: sang (loi set) -> xanh dam
colors=(
    "205;245;255"
    "140;225;255"
    "80;195;255"
    "30;160;255"
    "15;115;255"
    "10;75;215"
)

if (( cols >= 66 )); then
    lines=(
        '    ▟▛  ███████╗ ██████╗ ███╗   ██╗███████╗       ██████╗   ▟▛'
        '   ▟▛   ╚══███╔╝██╔═══██╗████╗  ██║██╔════╝      ██╔════╝  ▟▛'
        '  ▟█▄▄▖   ███╔╝ ██║   ██║██╔██╗ ██║█████╗  █████╗██║      ▟█▄▄▖'
        '    ▟▛   ███╔╝  ██║   ██║██║╚██╗██║██╔══╝  ╚════╝██║        ▟▛'
        '   ▟▛   ███████╗╚██████╔╝██║ ╚████║███████╗      ╚██████╗  ▟▛'
        '  ▝▀    ╚══════╝ ╚═════╝ ╚═╝  ╚═══╝╚══════╝       ╚═════╝ ▝▀'
    )
else
    lines=(
        ' ▟▛ ▀▀▀█ █▀▀█ █▄ █ █▀▀     █▀▀'
        '▟█▄▖ ▄▀  █  █ █ ▀█ █▀▀ ▀▀▀ █'
        ' ▟▛ █▄▄▄ █▄▄█ █  ▀ █▄▄     █▄▄'
        '▝▀'
    )
fi

echo
for i in "${!lines[@]}"; do
    c=${colors[$(( i * ${#colors[@]} / ${#lines[@]} ))]}
    printf '\e[1;38;2;%sm%s\e[0m\n' "$c" "${lines[$i]}"
done
echo
