#!/usr/bin/env bash
# Banner Zone-C khi mo terminal (Frost: chu ZONE-C mot mau glow, nhan theme mo o dong cuoi).

cols=$(tput cols 2>/dev/null || echo 80)

# Mac dinh theo thiet ke Frost: glow #9fd3e0, nhan mo #7d909a
glow="159;211;224"
dim="125;144;154"
label="frost"

# Theo theme dang dung cua Zone-C (scripts/term_sync.sh ghi file nay khi doi theme)
theme_file="${XDG_STATE_HOME:-$HOME/.local/state}/zone-c/term_theme.sh"
if [[ -f "$theme_file" ]]; then
    source "$theme_file"
    [[ -n ${ZONEC_GLOW-} ]] && glow="$ZONEC_GLOW"
    [[ -n ${ZONEC_DIM-} ]] && dim="$ZONEC_DIM"
    [[ -n ${ZONEC_LABEL-} ]] && label="$ZONEC_LABEL"
fi

if (( cols >= 60 )); then
    lines=(
        '███████╗ ██████╗ ███╗   ██╗███████╗      ██████╗'
        '╚══███╔╝██╔═══██╗████╗  ██║██╔════╝     ██╔════╝'
        '  ███╔╝ ██║   ██║██╔██╗ ██║█████╗ █████╗██║'
        ' ███╔╝  ██║   ██║██║╚██╗██║██╔══╝ ╚════╝██║'
        '███████╗╚██████╔╝██║ ╚████║███████╗     ╚██████╗'
        '╚══════╝ ╚═════╝ ╚═╝  ╚═══╝╚══════╝      ╚═════╝'
    )
else
    lines=(
        '▀▀▀█ █▀▀█ █▄ █ █▀▀     █▀▀'
        ' ▄▀  █  █ █ ▀█ █▀▀ ▀▀▀ █'
        '█▄▄▄ █▄▄█ █  ▀ █▄▄     █▄▄'
    )
fi

echo
last=$(( ${#lines[@]} - 1 ))
for i in "${!lines[@]}"; do
    if (( i == last )); then
        printf '\e[38;2;%sm%s\e[0m  \e[38;2;%sm%s\e[0m\n' "$glow" "${lines[$i]}" "$dim" "$label"
    else
        printf '\e[38;2;%sm%s\e[0m\n' "$glow" "${lines[$i]}"
    fi
done
