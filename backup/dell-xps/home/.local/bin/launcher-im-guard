#!/usr/bin/env bash
# Nhan nha SUPER: tam tat Unikey de o search cua launcher nhan duoc chu,
# dong launcher xong thi bat lai Unikey neu truoc do dang o VI.
#
# Chong loi Unikey bi tat luon:
#  - Chi mot guard chay mot luc (flock): bam Super lan nua de dong launcher
#    thi guard dang chay se lo viec bat lai.
#  - Chi tat Unikey khi launcher THUC SU hien ra; khong mo thi khong dung vao.
#  - Luon bat lai khi thoat (ke ca bi kill / het thoi gian cho).

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/launcher-im-guard.lock"
flock -n 9 || exit 0

# 2 = Unikey dang bat (VI), 1 = dang tat (EN)
[ "$(fcitx5-remote)" = "2" ] || exit 0

launcher_open() { hyprctl layers 2>/dev/null | grep -q 'namespace: qs-applauncher'; }

# Doi launcher hien ra (toi da 2s)
opened=0
for _ in $(seq 20); do
    launcher_open && { opened=1; break; }
    sleep 0.1
done
[ "$opened" = 1 ] || exit 0

restore() {
    sleep 0.15   # cho focus quay ve cua so cu
    fcitx5-remote -o
}
trap restore EXIT
trap 'exit 0' INT TERM HUP

fcitx5-remote -c

# Doi launcher dong (toi da 10 phut)
for _ in $(seq 2000); do
    launcher_open || break
    sleep 0.3
done
